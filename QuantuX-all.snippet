#!name = QuantuX 净化合集
#!author = Ksnqwe
#!update = 2026-11-12
#!desc = 腾讯体育 + 京东：去开屏广告、精简页面、去会员tab、去搜索热词

^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ (?i)\r\nUser-Agent:\s*QQSportsV3\/ url-and-header script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/app\.sports\.qq\.com\/feeds\/home(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/app\.sports\.qq\.com\/feeds\/list(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports-ad-clean.js
^https:\/\/api\.m\.jd\.com\/(?:client\.action|api)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/jd-ad-clean.js

hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com, api.m.jd.com
