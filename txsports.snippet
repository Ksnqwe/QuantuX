^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ (?i)\r\nUser-Agent:\s*QQSportsV3\/ url-and-header script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/app\.sports\.qq\.com\/feeds\/home(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/app\.sports\.qq\.com\/feeds\/list(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js
^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/Ksnqwe/QuantuX/main/txsports.bundle.js

